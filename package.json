{
  "name": "frontier-lab",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "Fourteen inspectable local experiments across workflows, data exchange, energy bills, warranties and privacy.",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node studio/server.js",
    "test": "node --test test/*.test.js",
    "test:browser": "node test/browser.mjs && node test/visual-browser.mjs && node test/wave-three-browser.mjs",
    "demo": "node scripts/demo.js",
    "check": "npm test && npm run demo",
    "pack:check": "node scripts/pack-check.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "demo:labs": "node scripts/lab-tour.mjs",
    "demo:branch-failure": "node packages/branch/bin/cli.js run examples/branch-failure.json"
  },
  "devDependencies": {
    "playwright": "^1.55.0",
    "prettier": "^3.9.9"
  }
}
